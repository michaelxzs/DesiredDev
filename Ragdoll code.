Ragdoll manager-
local ragdollMod = require(script.Parent:WaitForChild("Ragdoll"))
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local RagdollManager = {}

local ragdollData = {}  
RunService.Heartbeat:Connect(function()
	local now = tick()
	for userId, data in pairs(ragdollData) do
		if now >= data.EndTime then
			if data.Character and data.Character.Parent then
				ragdollMod.Stop(data.Character)
			end
			ragdollData[userId] = nil
		end
	end
end)

function RagdollManager.AddRagdoll(character, duration)
	local player = Players:GetPlayerFromCharacter(character)
	if not player then return end
	local userId = player.UserId

	ragdollMod.Start(character)
	ragdollData[userId] = {
		Character = character,
		EndTime = tick() + duration
	}
	
end

function RagdollManager.OnCharacterAdded(character)
	local player = Players:GetPlayerFromCharacter(character)
	if not player then return end

	local userId = player.UserId
	local data = ragdollData[userId]

	if data and tick() < data.EndTime then
		ragdollMod.Start(character)
		data.Character = character
	
	else
		ragdollData[userId] = nil
	end
end

function RagdollManager.OnPlayerRemoving(player)
	local data = ragdollData[player.UserId]
	if data and data.Character and data.Character.Parent then
		ragdollMod.Stop(data.Character)
	end
	ragdollData[player.UserId] = nil
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(RagdollManager.OnCharacterAdded)
end)

Players.PlayerRemoving:Connect(RagdollManager.OnPlayerRemoving)

return RagdollManager
